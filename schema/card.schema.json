{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JayashankaAnushan19/MasterBot/schema/card.schema.json",
  "title": "MasterBot cards.yaml",
  "description": "Validates a single topic's cards.yaml file.",
  "type": "object",
  "required": ["topic", "pillar", "module", "difficulty_base", "cards"],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug matching the topic's folder name."
    },
    "pillar": {
      "type": "string",
      "enum": ["it", "mechanical", "electronic"]
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Slug matching the module folder under the pillar (e.g. programming, kinematics)."
    },
    "difficulty_base": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/card" }
    }
  },
  "definitions": {
    "card": {
      "type": "object",
      "required": ["id", "type", "question", "answer", "options", "tags", "weight_seed"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Globally unique, e.g. it-prog-ros2-001."
        },
        "type": {
          "type": "string",
          "enum": ["qa", "mcq", "fill_blank", "matching"]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Populated only when type is mcq; empty array otherwise."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "weight_seed": {
          "type": "number",
          "minimum": 0,
          "description": "Starting difficulty weight before any answer history."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcq" } } },
          "then": { "properties": { "options": { "minItems": 2 } } }
        },
        {
          "if": { "not": { "properties": { "type": { "const": "mcq" } } } },
          "then": { "properties": { "options": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
