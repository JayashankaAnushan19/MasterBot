<?xml version="1.0" encoding="utf-8"?>
<!-- Motor cross-section: stator housing, rotor, shaft, four pole ticks -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <path android:fillColor="#101820" android:pathData="M0,0h120v120h-120z" />

    <!-- stator housing (outer ring) -->
    <path
        android:strokeColor="#00E5A0"
        android:strokeWidth="4"
        android:pathData="M20,60 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0" />

    <!-- pole ticks (N/E/S/W) -->
    <path android:strokeColor="#00E5A0" android:strokeWidth="4" android:pathData="M60,14 L60,24" />
    <path android:strokeColor="#00E5A0" android:strokeWidth="4" android:pathData="M60,96 L60,106" />
    <path android:strokeColor="#00E5A0" android:strokeWidth="4" android:pathData="M14,60 L24,60" />
    <path android:strokeColor="#00E5A0" android:strokeWidth="4" android:pathData="M96,60 L106,60" />

    <!-- rotor -->
    <path
        android:fillColor="#00B383"
        android:pathData="M38,60 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0" />

    <!-- shaft (hole) -->
    <path
        android:fillColor="#101820"
        android:pathData="M54,60 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
